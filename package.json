{
  "name": "local-git-reviewer",
  "version": "1.0.0",
  "description": "A locally run PR reviewer for a local Bitbucket Server environment",
  "license": "MIT",
  "author": "chax.at",
  "main": "dist/src/main-server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ci:build": "npm ci --include=dev && npm run build && npm prune --production",
    "ci:lint": "npm ci --include=dev && npm run lint",
    "ci:typecheck": "tsc --noEmit",
    "ci:audit": "npx --yes @chax-at/better-npm-audit@3.6.6 audit -l high -r https://registry.npmjs.org/",
    "ci:test": "vitest run",
    "start": "node dist/src/main-server.js",
    "start:server": "node dist/src/main-server.js",
    "start:cloud": "node dist/src/main-cloud.js",
    "start:forgejo": "node dist/src/main-forgejo.js",
    "start:development": "concurrently --handle-input \"wait-on dist/src/main-server.js && nodemon dist/src/main-server.js\" \"tsc -w -p tsconfig.build.json\"",
    "start:development:cloud": "concurrently --handle-input \"wait-on dist/src/main-cloud.js && nodemon dist/src/main-cloud.js\" \"tsc -w -p tsconfig.build.json\"",
    "start:development:forgejo": "concurrently --handle-input \"wait-on dist/src/main-forgejo.js && nodemon dist/src/main-forgejo.js\" \"tsc -w -p tsconfig.build.json\"",
    "start:prod": "npm run start:production",
    "start:production": "npm run start:server",
    "lint": "eslint -c .eslintrc.js --ignore-path .eslintignore \"./src/**\"",
    "ci:stylecheck": "prettier -c src",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset:all": "ts-node tools/reset-state.ts all",
    "reset:pr": "ts-node tools/reset-state.ts pr",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@chax-at/gelf-client": "^1.0.2",
    "@chax-at/log-sink": "^2.0.2",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "~2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "~2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "~2.12.0",
    "@opentelemetry/semantic-conventions": "~1.37.0",
    "config": "^3.3.9",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chax-at/eslint-config": "^0.0.9",
    "@types/config": "^3.3.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "concurrently": "^10.0.3",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "brace-expansion@1.x": "1.1.21",
    "brace-expansion@2.x": "2.1.7",
    "brace-expansion@5.x": "5.0.12",
    "js-yaml@4.x": "4.3.2",
    "nanoid@3.x": "3.3.18",
    "picomatch@2.x": "2.3.2",
    "postcss@8.x": "8.5.26",
    "vite@8.x": "8.3.6",
    "shell-quote": "1.10.0",
    "lodash": "4.18.1",
    "axios": "1.20.0",
    "follow-redirects": "1.16.2",
    "joi": "18.3.2"
  }
}
